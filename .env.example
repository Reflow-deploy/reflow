# Modelo do arquivo .env: copie este arquivo para .env e preencha com os dados do seu projeto Supabase.
# São lidos por src/lib/supabaseClient.js. O .env real NÃO vai para o GitHub (está no .gitignore).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
